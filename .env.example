# Copy to .env and fill in: cp .env.example .env  (.env is gitignored)
# Format: KEY=value, one per line, no quotes or inline comments. Shell variables win over .env.

# llm.provider: openai (configs/default.yaml)
OPENAI_API_KEY=

# llm.provider: fptcloud (configs/fptcloud.yaml), key from https://marketplace.fptcloud.com
FPTCLOUD_API_KEY=

# Optional: Hugging Face token for faster or authenticated dataset downloads
# HF_TOKEN=
